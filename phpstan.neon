includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    configDirectories:
        - config
        - app/Modules/*/config

    excludePaths:
        - app/Modules/*/resources/*

    level: 7
